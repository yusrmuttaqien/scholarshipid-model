# HuggingFace authentication for model artifact sync.
# Copy this file to .env and fill in your token.
# Get a token at: https://huggingface.co/settings/tokens

HF_TOKEN=your_hf_token_here

# LLM configuration for recommendation text and fit scores generation.
# Point LLM_BASE_URL to your llama.cpp server (via Cloudflare tunnel, ngrok, etc.)
# Set LLM_API_KEY if your llama.cpp instance requires authentication.
# Leave LLM_API_KEY empty to skip LLM calls entirely (scores still work).

LLM_BASE_URL=your_llm_base_url_here
LLM_MODEL=your_llm_model_here
LLM_API_KEY=your_llm_api_key_here
